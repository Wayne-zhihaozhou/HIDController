LIBRARY hid_controller
EXPORTS
    mouse_move_relative            @1
    mouse_move_absolute            @2
    mouse_down                     @3
    mouse_up                       @4
    mouse_click                    @5
    mouse_wheel                    @6
    set_mouse_move_coefficient     @7
    get_mouse_move_coefficient     @8
    auto_calibrate                 @9
    disable_mouse_acceleration     @10
    enable_mouse_acceleration      @11
    key_down                       @12
    key_up                         @13
    key_press                      @14
    key_combo                      @15
    key_seq                        @16
    release_all_keys               @17
    start_input_tracking           @18
    stop_input_tracking            @19
    is_tracking                    @20
    register_raw_input             @21
    get_device_name                @22
