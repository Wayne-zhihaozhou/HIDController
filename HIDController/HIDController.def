LIBRARY HIDController
EXPORTS
    MouseMoveRelative         @1
    MouseMoveAbsolute         @2
    MouseDown                 @3
    MouseUp                   @4
    MouseClick                @5
    MouseWheel                @6
    SetMouseMoveCoefficient   @7
    AutoCalibrate             @8
    DisableMouseAcceleration  @9
    EnableMouseAcceleration   @10
    KeyDown                   @11
    KeyUp                     @12
    KeyPress                  @13
    KeyCombo                  @14
    KeySeq                    @15
    release_all_keys          @16
